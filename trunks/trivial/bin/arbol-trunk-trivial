#!/bin/sh
trunk_bin=${0%/*}
[ "$trunk_bin" != "$0" ] || trunk_bin=.
trunk_dir=$(CDPATH= cd -- "$trunk_bin/.." && pwd -P) || exit 1
if [ -x "$trunk_dir/runtime/python/bin/python3.14" ]; then
    exec "$trunk_dir/runtime/python/bin/python3.14" -I -B "$trunk_dir/bin/entry.py" "$@"
fi
if [ -e "$trunk_dir/package-manifest.json" ] || [ -e "$trunk_dir/build.json" ]; then
    printf '%s\n' 'The Trivial Trunk package is missing its interpreter.' >&2
    exit 1
fi
exec "$trunk_dir/.venv/bin/python" -I -B "$trunk_dir/bin/entry.py" "$@"
